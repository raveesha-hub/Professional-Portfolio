{
  "entities": {
    "PortfolioMain": {
      "title": "PortfolioMain",
      "description": "Primary portfolio profile, hero, skills, education timeline, reflection, and contact metadata",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 80 },
        "role": { "type": "string", "maxLength": 120 },
        "uni": { "type": "string", "maxLength": 160 },
        "wel": { "type": "string", "maxLength": 300 },
        "about": { "type": "string", "maxLength": 3000 },
        "pic": { "type": "string" },
        "email": { "type": "string", "maxLength": 160 },
        "link": { "type": "string", "maxLength": 400 },
        "github": { "type": "string", "maxLength": 400 },
        "linkedin": { "type": "string", "maxLength": 400 },
        "careerGoals": { "type": "string", "maxLength": 1500 },
        "reflection": { "type": "string", "maxLength": 3000 }
      },
      "required": ["name", "role", "uni"]
    },
    "Project": {
      "title": "Project",
      "description": "Developer portfolio project displayed in the interactive 3D project cube",
      "type": "object",
      "properties": {
        "t": { "type": "string", "maxLength": 160 },
        "d": { "type": "string", "maxLength": 1000 },
        "fullDesc": { "type": "string", "maxLength": 4000 },
        "link": { "type": "string", "maxLength": 500 },
        "github": { "type": "string", "maxLength": 500 },
        "demo": { "type": "string", "maxLength": 500 },
        "order": { "type": "number" }
      },
      "required": ["t", "d"]
    },
    "Achievement": {
      "title": "Achievement",
      "description": "Certification, award, or academic milestone with media gallery",
      "type": "object",
      "properties": {
        "t": { "type": "string", "maxLength": 200 },
        "d": { "type": "string", "maxLength": 2000 },
        "date": { "type": "string", "maxLength": 60 },
        "issuer": { "type": "string", "maxLength": 160 },
        "link": { "type": "string", "maxLength": 500 },
        "order": { "type": "number" }
      },
      "required": ["t"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Visitor contact form inquiry stored for admin review",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 160 },
        "subject": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 4000 },
        "createdAt": { "type": "string", "maxLength": 60 },
        "read": { "type": "boolean" }
      },
      "required": ["name", "email", "message", "createdAt"]
    }
  },
  "firestore": {
    "/portfolio/main": {
      "schema": { "$ref": "#/entities/PortfolioMain" },
      "description": "Singleton document holding public portfolio copy, skills, education timeline, and contact channels"
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Portfolio projects collection"
    },
    "/achievements/{achievementId}": {
      "schema": { "$ref": "#/entities/Achievement" },
      "description": "Achievements and certificates collection"
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Visitor contact form submissions"
    }
  }
}
