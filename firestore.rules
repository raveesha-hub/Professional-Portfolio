rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'it26101283@my.sliit.lk';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['name', 'email', 'subject', 'message', 'createdAt', 'read'])
        && data.keys().hasOnly(['name', 'email', 'subject', 'message', 'createdAt', 'read'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.subject is string && data.subject.size() <= 200
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 4000
        && data.createdAt is string && data.createdAt.size() <= 60
        && data.read is bool && data.read == false;
    }

    // Publicly readable portfolio singleton; admin writable
    match /portfolio/main {
      allow get: if true;
      allow create, update, delete: if isAdmin();
    }

    // Publicly readable projects; admin writable
    match /projects/{projectId} {
      allow list: if true;
      allow get: if isValidId(projectId);
      allow create, update, delete: if isValidId(projectId) && isAdmin();
    }

    // Publicly readable achievements; admin writable
    match /achievements/{achievementId} {
      allow list: if true;
      allow get: if isValidId(achievementId);
      allow create, update, delete: if isValidId(achievementId) && isAdmin();
    }

    // Visitors can submit messages; only admin can read, update, or delete
    match /messages/{messageId} {
      allow create: if isValidId(messageId) && isValidMessage(request.resource.data);
      allow get, list: if isAdmin();
      allow update: if isValidId(messageId) && isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if isValidId(messageId) && isAdmin();
    }
  }
}
